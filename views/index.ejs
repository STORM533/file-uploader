<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Left-Luggage Depot</title>
    <link rel="stylesheet" href="/styles/common.css" />
    <link rel="stylesheet" href="/styles/home.css" />
  </head>
  <body>
    <header class="depot-header">
      <div class="wordmark">Left-Luggage Depot</div>
      <% if (locals.currentUser) { %>
      <div class="status-line owner">
        Checked in as: <%= currentUser.email %>
      </div>
      <% } else { %>
      <div class="status-line">Not checked in</div>
      <% } %>
    </header>

    <main class="ledger">
      <% if (locals.currentUser) { %>
      <div class="toolbar">
        <a class="btn btn-primary" href="/folders">View shelves</a>
        <a class="btn btn-brass" href="/log-out">Check out</a>
      </div>

      <hr class="perforation" />

      <div class="ticket">
        <span class="ticket-no">#A00-001</span>
        <div class="ticket-name">Welcome to the counter</div>
        <div class="ticket-meta">
          Your parcels and shelves are filed under your account.
        </div>
        <div class="ticket-actions">
          <a class="btn btn-primary" href="/files">Browse parcels</a>
        </div>
      </div>
      <% } else { %>
      <div class="ticket">
        <div class="ticket-name">No parcel on the counter</div>
        <div class="ticket-meta">Check in to file or claim a parcel.</div>
        <div class="ticket-actions">
          <a class="btn btn-primary" href="/log-in">Check In</a>
          <a class="btn btn-brass" href="/sign-up">Register</a>
        </div>
      </div>
      <% } %>
    </main>
  </body>
</html>
